<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#FFFFFF" />
            <corners android:radius="16dp" />
            <stroke
                android:width="1dp"
                android:color="#1F2937" />
            <padding
                android:left="14dp"
                android:top="10dp"
                android:right="36dp"
                android:bottom="10dp" />
        </shape>
    </item>

    <item
        android:gravity="end|center_vertical"
        android:width="18dp"
        android:height="18dp"
        android:right="12dp"
        android:drawable="@drawable/ic_chevron_down_18" />
</layer-list>
